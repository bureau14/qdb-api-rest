# .envrc -- single source of truth for the CGO environment used to compile
# against the two extracted packages, which are fetched and never
# committed: the QuasarDB C API in qdb/ and DuckDB with the quasar
# extension in duck/. Sourced by direnv on developer machines, by the
# root Makefile and the e2e Makefile before every go invocation, and by
# scripts/cicd/00.common.sh::cicd_setup_qdb_env for the CI shell.
#
# The vendored qdb-api-go carries its link line in cgo directives
# (vendor/github.com/bureau14/qdb-api-go/v3/library_link.go) whose
# ${SRCDIR}/qdb paths are dead inside vendor/; the CGO_CFLAGS/CGO_LDFLAGS
# below supply the real header and library locations.
#
# Why ${BASH_SOURCE[0]} instead of ${PWD}: CI scripts cd elsewhere before
# or after sourcing this file; BASH_SOURCE[0] resolves the repo root
# relative to the file itself, so the exports are correct regardless of the
# caller's working directory.
#
# Plain-bash requirement: this file MUST remain valid input for a bare
# `source .envrc` from any bash shell. No direnv stdlib functions (use,
# dotenv, source_up, layout, ...) -- they are unavailable in CI and would
# abort the source.

_QDB_REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

export QDB_API_DIR="${_QDB_REPO_ROOT}/qdb"
export QDB_LIB_DIR="${QDB_API_DIR}/lib"
export QDB_INCLUDE_DIR="${QDB_API_DIR}/include"

# duck/ holds qdb-duck's package in the layout of the C API package:
# include/duckdb.h and include/duckdb_static_extension.h everywhere,
# lib/libduckdb_bundle.a on Linux and FreeBSD (every DuckDB static
# library, the quasar extension and the loader that registers the
# linked extensions, in one archive without the qdb_api objects),
# lib/libduckdb.dylib on macOS, and bin/duckdb.dll with lib/duckdb.lib
# on Windows (ADR-0017).
export DUCK_API_DIR="${_QDB_REPO_ROOT}/duck"
export DUCK_LIB_DIR="${DUCK_API_DIR}/lib"
export DUCK_INCLUDE_DIR="${DUCK_API_DIR}/include"

# Linux links libqdb_api statically (the cgo directives add -Wl,-Bstatic
# -lqdb_api -lstdc++ and -static-libgcc; GCC 13+ is required for that
# libstdc++, CI pins quasardb's gcc via CC/CXX), so only the header and library
# locations are needed and nothing loads libqdb_api.so at runtime.
#
# DuckDB is linked the way qdb-duck ships it, and the duckdb-go binding
# has one build tag per way: duckdb_use_static_lib adds no link line and
# defines the static export macro, so Linux and FreeBSD link the bundle
# through CGO_LDFLAGS. Under that tag the binding also calls the
# bundle's registration function, duckdb_register_static_extensions,
# from its package init, so the bundle must define it, and a bundle
# without it fails the link with an undefined symbol. duckdb_use_lib
# links -lduckdb with the import macro the Windows DLL needs, so macOS
# and Windows take it. One tag for all three cannot work. duckdb_arrow
# enables the binding's Arrow interface, which is how a result leaves
# the engine. The tags travel in GOFLAGS so that every go invocation,
# golangci-lint's typecheck included, sees the same ones. Without them
# the binding compiles against the stubs of third_party/ and the binary
# fails to link.
#
# The bundle precedes libqdb_api on the Linux and FreeBSD link lines,
# because the bundle references the C API's symbols and a static archive
# resolves only what is already pending. Go places CGO_LDFLAGS before the
# flags of the cgo directives, so the order falls out of the two sources.
# The bundle's objects also need a C++ runtime and libm. On Linux the
# cgo directive names both (-lstdc++ and -lm). On FreeBSD the directive
# names only the shared libqdb_api.so (quasardb packages the static
# archive on Linux only), so the FreeBSD line adds -lc++ and -lm itself.
#
# FreeBSD and Darwin link the shared library and bake two rpath entries:
# the absolute ${QDB_LIB_DIR}, so binaries built from the checkout run
# without loader-path variables (the e2e harness relies on this), and
# $ORIGIN / @loader_path, so a copied binary finds a libqdb_api placed next
# to it. $ORIGIN is backslash-escaped so the literal reaches the linker;
# Go passes CGO_LDFLAGS tokens via exec, no shell expansion happens.
case "$(uname)" in
    Linux)
        export CGO_CFLAGS="${CGO_CFLAGS:+${CGO_CFLAGS} }-I${QDB_INCLUDE_DIR} -I${DUCK_INCLUDE_DIR}"
        export CGO_LDFLAGS="${CGO_LDFLAGS:+${CGO_LDFLAGS} }-L${QDB_LIB_DIR} -L${DUCK_LIB_DIR} -lduckdb_bundle"
        export GOFLAGS="${GOFLAGS:+${GOFLAGS} }-tags=duckdb_use_static_lib,duckdb_arrow"
        ;;
    FreeBSD)
        export LD_LIBRARY_PATH="${QDB_LIB_DIR}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
        export CGO_CFLAGS="${CGO_CFLAGS:+${CGO_CFLAGS} }-I${QDB_INCLUDE_DIR} -I${DUCK_INCLUDE_DIR}"
        export CGO_LDFLAGS="${CGO_LDFLAGS:+${CGO_LDFLAGS} }-L${QDB_LIB_DIR} -L${DUCK_LIB_DIR} -lduckdb_bundle -lc++ -lm -Wl,-rpath -Wl,${QDB_LIB_DIR} -Wl,-rpath -Wl,\$ORIGIN"
        export GOFLAGS="${GOFLAGS:+${GOFLAGS} }-tags=duckdb_use_static_lib,duckdb_arrow"
        ;;
    Darwin)
        export DYLD_LIBRARY_PATH="${QDB_LIB_DIR}:${DUCK_LIB_DIR}${DYLD_LIBRARY_PATH:+:${DYLD_LIBRARY_PATH}}"
        export CGO_CFLAGS="${CGO_CFLAGS:+${CGO_CFLAGS} }-I${QDB_INCLUDE_DIR} -I${DUCK_INCLUDE_DIR}"
        export CGO_LDFLAGS="${CGO_LDFLAGS:+${CGO_LDFLAGS} }-L${QDB_LIB_DIR} -L${DUCK_LIB_DIR} -lduckdb -Wl,-rpath -Wl,${QDB_LIB_DIR} -Wl,-rpath -Wl,${DUCK_LIB_DIR} -Wl,-rpath -Wl,@loader_path"
        export GOFLAGS="${GOFLAGS:+${GOFLAGS} }-tags=duckdb_use_lib,duckdb_arrow"
        ;;
    MINGW*)
        # /c/mingw64/bin maps to native C:\mingw64\bin where gcc.exe lives on
        # the Buildkite Windows agents; the MSYS-internal /mingw64/bin does
        # NOT resolve there. Without this prepend go.exe finds no gcc and
        # silently disables cgo ("go: -race requires cgo", or every
        # `import "C"` file excluded from the compile). The package
        # directories on PATH (qdb/lib, qdb/bin and duck/bin) let the
        # built binaries and test binaries load qdb_api.dll and
        # duckdb.dll. Unlike the Unix branches, -lqdb_api is passed here
        # explicitly because the directive's -L${SRCDIR}/qdb/bin is a dead
        # path in the vendor tree.
        #
        # The gcc in C:\mingw64 is a UCRT build of MinGW, which the agent
        # image in qdb-cloud-deployments installs. Its malloc and free use
        # the process heap, as does the C runtime that MSVC links into
        # duckdb.dll and qdb_api.dll. The DuckDB binding
        # (duckdb-go-bindings) relies on that shared heap, because it hands
        # the strings and arrays it allocates in cgo (C.CString, C.calloc)
        # to duckdb_free, which frees them inside duckdb.dll. An msvcrt
        # build of MinGW allocates from a heap of its own, so the first
        # such free corrupts the heap, and the process dies with
        # 0xC0000374 when the first DuckDB instance opens.
        #
        # The MSYS runtime rewrites environment values that look like
        # paths when it starts a native program such as go.exe, and the
        # rewrite is a heuristic: it converts the first POSIX path of a
        # value and leaves the rest, and it splits a value on a colon as if
        # it were a path list, so a native Q:/ path inside it comes out
        # mangled. The two cgo variables are therefore excluded from the
        # rewrite and every path in them is written natively through
        # cygpath, so gcc receives exactly what is exported here.
        # -lqdb_api resolves through lib/qdb_api.lib and -lduckdb through
        # lib/duckdb.lib, the import libraries next to the DLLs.
        export MSYS2_ENV_CONV_EXCL="CGO_CFLAGS;CGO_LDFLAGS"
        export PATH="/c/mingw64/bin:${QDB_LIB_DIR}:${QDB_API_DIR}/bin:${DUCK_API_DIR}/bin:${PATH}"
        export CGO_CFLAGS="${CGO_CFLAGS:+${CGO_CFLAGS} }-I$(cygpath -m "${QDB_INCLUDE_DIR}") -I$(cygpath -m "${DUCK_INCLUDE_DIR}")"
        export CGO_LDFLAGS="${CGO_LDFLAGS:+${CGO_LDFLAGS} }-L$(cygpath -m "${QDB_LIB_DIR}") -L$(cygpath -m "${QDB_API_DIR}/bin") -lqdb_api -L$(cygpath -m "${DUCK_LIB_DIR}") -lduckdb"
        export GOFLAGS="${GOFLAGS:+${GOFLAGS} }-tags=duckdb_use_lib,duckdb_arrow"
        ;;
    *)
        echo ".envrc: unknown OS '$(uname)'" >&2
        return 1
        ;;
esac

unset _QDB_REPO_ROOT
