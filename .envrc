# .envrc -- single source of truth for the CGO environment used to compile
# against the QuasarDB C API in qdb/ (the extracted c-api archive; fetched,
# never committed).
#
# Loaded by two consumers:
#   1. direnv on developer machines (automatically on cd into the repo), and
#      the root Makefile, which sources it before every go invocation.
#   2. scripts/cicd/00.common.sh::cicd_setup_qdb_env, which sources it from
#      inside a bash function so the same variables reach the CI shell.
#
# The vendored qdb-api-go carries its link line in cgo directives
# (vendor/github.com/bureau14/qdb-api-go/v3/library_link.go) whose
# ${SRCDIR}/qdb paths are dead inside vendor/; the CGO_CFLAGS/CGO_LDFLAGS
# below supply the real header and library locations.
#
# Per-OS variable matrix:
#   Linux           -> CGO_CFLAGS + CGO_LDFLAGS (static libqdb_api.a, no loader path)
#   FreeBSD         -> LD_LIBRARY_PATH + CGO_CFLAGS + CGO_LDFLAGS
#   Darwin          -> DYLD_LIBRARY_PATH + CGO_CFLAGS + CGO_LDFLAGS
#   MINGW*          -> PATH (prepend gcc, qdb/lib and qdb/bin) + CGO_CFLAGS + CGO_LDFLAGS
#
# Why ${BASH_SOURCE[0]} instead of ${PWD}: CI scripts cd elsewhere before
# or after sourcing this file; BASH_SOURCE[0] resolves the repo root
# relative to the file itself, so the exports are correct regardless of the
# caller's working directory.
#
# Plain-bash requirement: this file MUST remain valid input for a bare
# `source .envrc` from any bash shell. No direnv stdlib functions (use,
# dotenv, source_up, layout, ...) -- they are unavailable in CI and would
# abort the source.

_QDB_REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

export QDB_API_DIR="${_QDB_REPO_ROOT}/qdb"
export QDB_LIB_DIR="${QDB_API_DIR}/lib"
export QDB_INCLUDE_DIR="${QDB_API_DIR}/include"

# Linux links libqdb_api statically (the cgo directives add -Wl,-Bstatic
# -lqdb_api -lstdc++ and -static-libgcc; GCC 13+ is required for that
# libstdc++, CI pins gcc15 via CC/CXX), so only the header and library
# locations are needed and nothing loads libqdb_api.so at runtime.
#
# FreeBSD and Darwin link the shared library and bake two rpath entries:
# the absolute ${QDB_LIB_DIR}, so binaries built from the checkout run
# without loader-path variables (the e2e harness relies on this), and
# $ORIGIN / @loader_path, so a copied binary finds a libqdb_api placed next
# to it. $ORIGIN is backslash-escaped so the literal reaches the linker;
# Go passes CGO_LDFLAGS tokens via exec, no shell expansion happens.
case "$(uname)" in
    Linux)
        export CGO_CFLAGS="${CGO_CFLAGS:+${CGO_CFLAGS} }-I${QDB_INCLUDE_DIR}"
        export CGO_LDFLAGS="${CGO_LDFLAGS:+${CGO_LDFLAGS} }-L${QDB_LIB_DIR}"
        ;;
    FreeBSD)
        export LD_LIBRARY_PATH="${QDB_LIB_DIR}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
        export CGO_CFLAGS="${CGO_CFLAGS:+${CGO_CFLAGS} }-I${QDB_INCLUDE_DIR}"
        export CGO_LDFLAGS="${CGO_LDFLAGS:+${CGO_LDFLAGS} }-L${QDB_LIB_DIR} -Wl,-rpath -Wl,${QDB_LIB_DIR} -Wl,-rpath -Wl,\$ORIGIN"
        ;;
    Darwin)
        export DYLD_LIBRARY_PATH="${QDB_LIB_DIR}${DYLD_LIBRARY_PATH:+:${DYLD_LIBRARY_PATH}}"
        export CGO_CFLAGS="${CGO_CFLAGS:+${CGO_CFLAGS} }-I${QDB_INCLUDE_DIR}"
        export CGO_LDFLAGS="${CGO_LDFLAGS:+${CGO_LDFLAGS} }-L${QDB_LIB_DIR} -Wl,-rpath -Wl,${QDB_LIB_DIR} -Wl,-rpath -Wl,@loader_path"
        ;;
    MINGW*)
        # /c/mingw64/bin maps to native C:\mingw64\bin where gcc.exe lives on
        # the Buildkite Windows agents; the MSYS-internal /mingw64/bin does
        # NOT resolve there. Without this prepend go.exe finds no gcc and
        # silently disables cgo ("go: -race requires cgo", or every
        # `import "C"` file excluded from the compile). qdb/lib and qdb/bin
        # on PATH let the built binaries and test binaries load
        # qdb_api.dll. Unlike the Unix branches, -lqdb_api is passed here
        # explicitly because the directive's -L${SRCDIR}/qdb/bin is a dead
        # path in the vendor tree.
        export PATH="/c/mingw64/bin:${QDB_LIB_DIR}:${QDB_API_DIR}/bin:${PATH}"
        export CGO_CFLAGS="${CGO_CFLAGS:+${CGO_CFLAGS} }-I${QDB_INCLUDE_DIR}"
        export CGO_LDFLAGS="${CGO_LDFLAGS:+${CGO_LDFLAGS} }-L${QDB_LIB_DIR} -L${QDB_API_DIR}/bin -lqdb_api"
        ;;
    *)
        echo ".envrc: unknown OS '$(uname)'" >&2
        return 1
        ;;
esac

unset _QDB_REPO_ROOT
